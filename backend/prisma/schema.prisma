generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReportRunStatus {
  SCHEDULED
  EXTRACTING
  VALIDATING
  SNAPSHOT_SAVED
  RENDERING
  READY_TO_SEND
  SENDING
  SENT
  RETRY_WAIT
  DEGRADED_READY
  SENT_DEGRADED
  FAILED_ALERTED
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
  BLOCKED
}

enum AgentToolCallStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum UserRole {
  ADMIN
  MANAGER
  USER
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

enum ChatMessageStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELED
}

enum ChatAnswerability {
  ANSWERED
  UNANSWERED
}

enum ChatAnswerabilitySource {
  SYSTEM
  ADMIN
}

enum AiUsageScopeType {
  USER
  AGENT
}

enum AiOperationStatus {
  STARTED
  COMPLETED
  FAILED
  CANCELED
  REJECTED
}

enum KnowledgeDocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum KnowledgeVersionStatus {
  PROCESSING
  READY
  FAILED
}

enum WorkTaskStatus {
  DRAFT
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  COMPLETED
  REJECTED
  CANCELED
}

enum WorkTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TeamDailyReportStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

enum NotificationCategory {
  TASK
  REPORT
}

model DailyReportRun {
  id            String          @id @default(cuid())
  reportDate    DateTime        @unique @db.Date
  status        ReportRunStatus @default(SCHEDULED)
  attempt       Int             @default(0)
  correlationId String          @unique
  degraded      Boolean         @default(false)
  lastError     String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  snapshot      MetricSnapshot?
  artifact      ReportArtifact?
  auditEvents   AuditEvent[]
}

model MetricSnapshot {
  id              String         @id @default(cuid())
  runId           String         @unique
  run             DailyReportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  specVersion     String
  windowStartUtc  DateTime
  windowEndUtc    DateTime
  sourceFreshness Json
  metrics         Json
  validation      Json
  createdAt       DateTime       @default(now())
  agentRuns       AgentRun[]
}

model ReportArtifact {
  id                String         @id @default(cuid())
  runId             String         @unique
  run               DailyReportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  content           String
  promptVersion     String?
  model             String?
  inputTokens       Int?
  outputTokens      Int?
  estimatedCostUsd  Decimal?       @db.Decimal(12, 6)
  telegramMessageId String?
  sentAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model AuditEvent {
  id        String           @id @default(cuid())
  runId     String
  run       DailyReportRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  fromState ReportRunStatus?
  toState   ReportRunStatus
  attempt   Int
  detail    Json?
  createdAt DateTime         @default(now())

  @@index([runId, createdAt])
}

model AgentRun {
  id               String          @id @default(cuid())
  agentId          String
  capabilityId     String
  status           AgentRunStatus  @default(RUNNING)
  input            Json
  output           Json?
  model            String?
  promptVersion    String?
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Decimal?        @db.Decimal(12, 6)
  error            String?
  actorUserId      String?
  conversationId   String?
  operationAuditId String?         @unique
  metricSnapshotId String?
  metricSnapshot   MetricSnapshot? @relation(fields: [metricSnapshotId], references: [id], onDelete: SetNull)
  startedAt        DateTime        @default(now())
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  toolCalls        AgentToolCall[]

  @@index([agentId, capabilityId, createdAt])
  @@index([metricSnapshotId])
  @@index([actorUserId, createdAt])
  @@index([conversationId, createdAt])
}

model AgentToolCall {
  id          String              @id @default(cuid())
  agentRunId  String
  agentRun    AgentRun            @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  toolId      String
  status      AgentToolCallStatus @default(RUNNING)
  input       Json
  output      Json?
  error       String?
  startedAt   DateTime            @default(now())
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([agentRunId, createdAt])
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  displayName             String
  departmentCode          String?
  departmentId            String?
  department              Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamId                  String?
  team                    OrganizationTeam?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  externalSource          String?
  externalUserId          String?
  employeeCode            String?
  passwordHash            String
  passwordResetRequired   Boolean                  @default(false)
  role                    UserRole                 @default(USER)
  status                  UserStatus               @default(ACTIVE)
  failedLoginAttempts     Int                      @default(0)
  lockedUntil             DateTime?
  lastLoginAt             DateTime?
  passwordChangedAt       DateTime                 @default(now())
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  sessions                Session[]
  accessGrants            AgentAccessGrant[]       @relation("GrantSubject")
  grantsIssued            AgentAccessGrant[]       @relation("GrantIssuer")
  accessAuditEvents       AccessAuditEvent[]       @relation("AuditActor")
  chatConversations       ChatConversation[]
  aiOperationAudits       AiOperationAudit[]
  chatQuestionEvaluations ChatQuestionEvaluation[]
  chatAttachments         ChatAttachment[]
  conversationMemories    ConversationMemory[]
  tasksCreated            WorkTask[]               @relation("TaskCreator")
  tasksAssigned           WorkTask[]               @relation("TaskAssignee")
  taskUpdates             WorkTaskUpdate[]
  taskTimeEntries         WorkTaskTimeEntry[]      @relation("TaskTimeActor")
  checklistItemsCompleted WorkTaskChecklistItem[]  @relation("ChecklistCompletedBy")
  teamReportsCreated      TeamDailyReport[]         @relation("TeamReportCreator")
  teamReportsSubmitted    TeamDailyReport[]         @relation("TeamReportSubmitter")
  teamReportsAcknowledged TeamDailyReport[]         @relation("TeamReportAcknowledger")
  teamReportComments      TeamDailyReportComment[]
  notificationsReceived  Notification[]            @relation("NotificationRecipient")
  notificationsTriggered Notification[]            @relation("NotificationActor")

  @@unique([externalSource, externalUserId])
  @@index([role, status])
  @@index([departmentCode, status])
  @@index([departmentId, teamId, status])
}

model Department {
  id        String             @id @default(cuid())
  code      String             @unique
  name      String
  agentId   String?
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  teams     OrganizationTeam[]
  users     User[]
  dailyReports TeamDailyReport[]

  @@index([isActive, name])
}

model OrganizationTeam {
  id             String     @id @default(cuid())
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  code           String
  name           String
  externalSource String?
  externalId     String?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  users          User[]
  tasks          WorkTask[]
  dailyReports   TeamDailyReport[]

  @@unique([departmentId, code])
  @@unique([externalSource, externalId])
  @@index([departmentId, isActive, name])
}

model TeamDailyReport {
  id                 String                @id @default(cuid())
  departmentId       String
  department         Department            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  departmentCode     String
  departmentName     String
  teamId             String
  team               OrganizationTeam      @relation(fields: [teamId], references: [id], onDelete: Restrict)
  reportDate         DateTime               @db.Date
  status             TeamDailyReportStatus @default(DRAFT)
  summary            String
  completedWork      String
  inProgressWork     String
  blockers           String
  nextPlan           String
  createdById        String
  createdBy          User                   @relation("TeamReportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submittedById      String?
  submittedBy        User?                  @relation("TeamReportSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt        DateTime?
  acknowledgedById   String?
  acknowledgedBy     User?                  @relation("TeamReportAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  acknowledgedAt     DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  comments           TeamDailyReportComment[]

  @@unique([teamId, reportDate])
  @@index([departmentId, reportDate])
  @@index([teamId, reportDate])
  @@index([status, reportDate])
}

model TeamDailyReportComment {
  id          String          @id @default(cuid())
  reportId    String
  report      TeamDailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorUserId String
  actor       User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  message     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([reportId, createdAt])
  @@index([actorUserId, createdAt])
}

model Notification {
  id              String               @id @default(cuid())
  recipientUserId String
  recipient       User                 @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actorUserId     String?
  actor           User?                @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  category        NotificationCategory
  eventType       String
  title           String
  message         String
  entityType      String
  entityId        String
  route           String
  metadata        Json?
  readAt          DateTime?
  createdAt       DateTime             @default(now())

  @@index([recipientUserId, readAt, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model WorkTask {
  id              String                  @id @default(cuid())
  code            String                  @unique
  title           String
  description     String
  departmentCode  String
  departmentName  String
  teamId          String?
  team            OrganizationTeam?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  agentId         String?
  priority        WorkTaskPriority        @default(NORMAL)
  status          WorkTaskStatus          @default(DRAFT)
  position        Int                     @default(0)
  progressPercent Int                     @default(0)
  dueAt           DateTime?
  estimatedMinutes Int?
  startedAt       DateTime?
  activeTimeSeconds Int                   @default(0)
  activeTimerStartedAt DateTime?
  submittedAt     DateTime?
  completedAt     DateTime?
  blockedReason   String?
  completionNote  String?
  archivedAt      DateTime?
  archivedById    String?
  createdById     String
  createdBy       User                    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assigneeId      String?
  assignee        User?                   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  updates         WorkTaskUpdate[]
  timeEntries     WorkTaskTimeEntry[]
  checklistItems  WorkTaskChecklistItem[]

  @@index([departmentCode, status, dueAt])
  @@index([departmentCode, status, position])
  @@index([teamId, status, dueAt])
  @@index([assigneeId, status, dueAt])
  @@index([createdById, createdAt])
  @@index([archivedAt, status, completedAt])
}

model WorkTaskTimeEntry {
  id              String    @id @default(cuid())
  taskId          String
  task            WorkTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorUserId     String
  actor           User      @relation("TaskTimeActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([taskId, startedAt])
  @@index([actorUserId, startedAt])
  @@index([taskId, endedAt])
}

model WorkTaskChecklistItem {
  id            String    @id @default(cuid())
  taskId        String
  task          WorkTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title         String
  position      Int       @default(0)
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("ChecklistCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([taskId, position])
  @@index([completedById])
}

model WorkTaskUpdate {
  id              String          @id @default(cuid())
  taskId          String
  task            WorkTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorUserId     String
  actor           User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  type            String
  message         String?
  fromStatus      WorkTaskStatus?
  toStatus        WorkTaskStatus?
  progressPercent Int?
  metadata        Json?
  createdAt       DateTime        @default(now())

  @@index([taskId, createdAt])
  @@index([actorUserId, createdAt])
}

model KnowledgeDocument {
  id                   String                     @id @default(cuid())
  agentId              String                     @default("ceo-ai")
  title                String
  slug                 String                     @unique
  category             String
  description          String?
  ownerDepartmentCode  String
  ownerDepartmentName  String
  ownerName            String
  status               KnowledgeDocumentStatus    @default(DRAFT)
  currentVersionNumber Int                        @default(0)
  isMock               Boolean                    @default(false)
  createdById          String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  versions             KnowledgeDocumentVersion[]
  accessRules          KnowledgeDocumentAccess[]

  @@index([agentId, status, updatedAt])
  @@index([ownerDepartmentCode, status])
  @@index([isMock, status])
}

model KnowledgeDocumentVersion {
  id               String                 @id @default(cuid())
  documentId       String
  document         KnowledgeDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber    Int
  status           KnowledgeVersionStatus @default(PROCESSING)
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  sourceType       String
  sourceUrl        String?
  originalFileName String?
  mimeType         String?
  objectKey        String?
  checksumSha256   String
  extractedText    String
  characterCount   Int
  chunkCount       Int                    @default(0)
  embeddingModel   String?
  error            String?
  createdById      String?
  indexedAt        DateTime?
  createdAt        DateTime               @default(now())
  chunks           KnowledgeChunk[]

  @@unique([documentId, versionNumber])
  @@index([documentId, status, createdAt])
  @@index([effectiveFrom, effectiveTo])
}

model KnowledgeChunk {
  id             String                   @id @default(cuid())
  versionId      String
  version        KnowledgeDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  chunkIndex     Int
  content        String
  tokenEstimate  Int
  embedding      Json
  embeddingModel String
  metadata       Json?
  createdAt      DateTime                 @default(now())

  @@unique([versionId, chunkIndex])
  @@index([versionId, chunkIndex])
}

model KnowledgeDocumentAccess {
  id             String            @id @default(cuid())
  documentId     String
  document       KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  departmentCode String
  departmentName String
  canRead        Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([documentId, departmentCode])
  @@index([departmentCode, canRead])
}

model AiRateLimitBucket {
  key             String   @id
  windowStartedAt DateTime
  requestCount    Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model AiUsagePolicy {
  id              String           @id @default(cuid())
  scopeType       AiUsageScopeType
  scopeId         String
  dailyTokenLimit Int
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([scopeType, scopeId])
  @@index([scopeType, isActive])
}

model AiDailyUsage {
  id               String           @id @default(cuid())
  usageDate        DateTime         @db.Date
  scopeType        AiUsageScopeType
  scopeId          String
  inputTokens      Int              @default(0)
  outputTokens     Int              @default(0)
  reservedTokens   Int              @default(0)
  requestCount     Int              @default(0)
  estimatedCostUsd Decimal          @default(0) @db.Decimal(14, 6)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([usageDate, scopeType, scopeId])
  @@index([scopeType, scopeId, usageDate])
}

model AiOperationAudit {
  id                 String            @id @default(cuid())
  userId             String?
  user               User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  agentId            String
  capabilityId       String
  conversationId     String?
  userMessageId      String?
  assistantMessageId String?
  agentRunId         String?
  status             AiOperationStatus @default(STARTED)
  question           String
  model              String?
  inputTokens        Int?
  outputTokens       Int?
  estimatedCostUsd   Decimal?          @db.Decimal(14, 6)
  toolCalls          Json?
  errorCode          String?
  error              String?
  metadata           Json?
  startedAt          DateTime          @default(now())
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@index([conversationId, createdAt])
  @@index([status, createdAt])
}

model HttpRequestLog {
  id           String   @id @default(cuid())
  requestId    String   @unique
  method       String
  path         String
  routePath    String?
  statusCode   Int
  durationMs   Int
  userId       String?
  userRole     String?
  ipAddress    String?
  userAgent    String?
  errorName    String?
  errorCode    String?
  errorMessage String?
  errorStack   String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([statusCode, createdAt])
  @@index([userId, createdAt])
}

model ChatConversation {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId     String
  title       String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  messages    ChatMessage[]
  attachments ChatAttachment[]
  memory      ConversationMemory?

  @@index([userId, updatedAt])
  @@index([agentId, updatedAt])
}

model ConversationMemory {
  id             String           @id @default(cuid())
  conversationId String           @unique
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId        String
  summary        String
  embedding      Json
  embeddingModel String
  messageCount   Int
  lastMessageAt  DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId, agentId, updatedAt])
  @@index([agentId, updatedAt])
}

model CeoAnswerCache {
  id                   String    @id @default(cuid())
  exactHash            String    @unique
  agentId              String
  capabilityId         String
  scopeKey             String
  knowledgeFingerprint String
  promptVersion        String
  normalizedQuestion   String
  questionEmbedding    Json
  answer               Json
  hitCount             Int       @default(0)
  lastHitAt            DateTime?
  expiresAt            DateTime
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([agentId, capabilityId, scopeKey, knowledgeFingerprint, promptVersion, expiresAt])
  @@index([expiresAt])
}

model ChatMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatMessageRole
  status         ChatMessageStatus @default(PENDING)
  content        String
  reportDate     String?
  agentRunId     String?
  sources        Json?
  suggestions    Json?
  error          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  attachments    ChatAttachment[]

  @@index([conversationId, createdAt])
  @@index([agentRunId])
}

model ChatAttachment {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        ChatMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  objectKey      String           @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  checksumSha256 String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
  @@index([messageId])
}

model ChatQuestionEvaluation {
  id                 String                  @id @default(cuid())
  userId             String?
  user               User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversationId     String
  userMessageId      String                  @unique
  assistantMessageId String                  @unique
  agentRunId         String?
  agentId            String
  question           String
  answer             String
  classification     ChatAnswerability
  reasonCode         String
  reason             String?
  source             ChatAnswerabilitySource @default(SYSTEM)
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([classification, createdAt])
  @@index([userId, classification, createdAt])
  @@index([agentId, classification, createdAt])
}

model ProductVisualProfile {
  id            String   @id @default(cuid())
  productId     Int      @unique
  productName   String
  productStyle  String?
  productBrand  String?
  imageUrl      String
  imageChecksum String
  descriptor    Json
  indexedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([updatedAt])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model DataScope {
  id          String   @id
  agentId     String
  name        String
  description String?
  definition  Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agentId, isActive])
}

model AgentAccessGrant {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("GrantSubject", fields: [userId], references: [id], onDelete: Cascade)
  agentId       String
  capabilityIds Json
  dataScopeIds  Json
  actions       Json
  grantedById   String
  grantedBy     User      @relation("GrantIssuer", fields: [grantedById], references: [id], onDelete: Restrict)
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, agentId, revokedAt])
  @@index([grantedById, createdAt])
}

model AccessAuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  actorUser   User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  eventType   String
  targetType  String?
  targetId    String?
  ipAddress   String?
  userAgent   String?
  detail      Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
  @@index([targetType, targetId, createdAt])
}
