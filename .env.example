NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://feline_ai:change_me@postgres:5432/feline_ai?schema=public
REDIS_HOST=redis
REDIS_PORT=6379
SCHEDULER_ENABLED=true
REPORT_TIME_ZONE=Asia/Ho_Chi_Minh
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_DEFAULT_REGION=us-east-005
B2_BUCKET=Lemiex-Fulfillment
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_USE_PATH_STYLE_ENDPOINT=false
REPORT_QUEUE_NAME=workshop-daily-report
LOG_LEVEL=info

# Xác thực Dashboard/API.
AUTH_COOKIE_NAME=feline_session
AUTH_SESSION_TTL_HOURS=168
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
# Chỉ bật true khi Dashboard phục vụ qua HTTPS.
AUTH_COOKIE_SECURE=false

# User chỉ đọc được giới hạn theo IP máy chạy AI và bắt buộc TLS.
SOURCE_MYSQL_URL=
SOURCE_MYSQL_SSL=true
SOURCE_MYSQL_CA_PATH=/app/certs/shop-test-mysql-ca.pem

# Nguồn phòng Sell TikTok. Production dùng SSH tunnel chỉ đọc tại host:13306.
TIKTOK_MYSQL_URL=mysql://feline_ai_tiktok_ro:change_me@host.docker.internal:13306/feline
TIKTOK_MYSQL_SSL=false
TIKTOK_MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Nguồn Etsy chỉ đọc qua HTTPS export API của manager.felineez.com.
ETSY_DATA_API_URL=https://manager.felineez.com/api/export/etsy-dashboard
ETSY_DATA_API_SECRET=
ETSY_DATA_TIMEOUT_MS=15000

# Telegram sẽ bật ở bước phân phối báo cáo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Lemiex AI chỉ chạy khi đủ API key, model và cờ enabled.
ANTHROPIC_API_KEY=
# Bắt buộc với API key cấp tổ chức; để trống nếu key đã scope vào workspace.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=
LEMIEX_AI_ENABLED=false
AI_CHAT_MAX_OUTPUT_TOKENS=1000
AI_MAX_OUTPUT_TOKENS=1800
AI_REQUEST_TIMEOUT_MS=30000
# Giới hạn toàn bộ một lượt chat, gồm đọc dữ liệu và gọi model.
AI_CHAT_TIMEOUT_MS=45000
# Anthropic chỉ retry lỗi kết nối, 429 và 5xx; đặt 0 để tắt retry.
AI_PROVIDER_MAX_RETRIES=2
# Fixed-window rate limit theo tài khoản.
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
# Giữ trước token để các request đồng thời không vượt quota ngày.
AI_CHAT_TOKEN_RESERVATION=4000
AI_DAILY_TOKEN_LIMIT_ENABLED=false
AI_DAILY_TOKEN_LIMIT_PER_USER=50000
AI_DAILY_TOKEN_LIMIT_PER_AGENT=500000
# Dùng để ước tính chi phí; cấu hình theo model thực tế trên Anthropic Console.
ANTHROPIC_INPUT_COST_PER_MILLION=
ANTHROPIC_OUTPUT_COST_PER_MILLION=
# Knowledge Hub: chỉ bật để tạo bộ tài liệu mẫu ở lần khởi động đầu tiên.
KNOWLEDGE_MOCK_SEED_ENABLED=true
